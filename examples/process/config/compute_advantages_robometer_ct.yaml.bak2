# Advantage computation for CFG-RL training
#
# Usage:
#   cd examples/process && python compute_advantages.py --config-name compute_advantages \
#       advantage.value_checkpoint=/path/to/checkpoint
#
# Multi-GPU:
#   cd examples/process && torchrun --nproc_per_node=4 compute_advantages.py \
#       --config-name compute_advantages \
#       advantage.value_checkpoint=/path/to/checkpoint

defaults:
  - model/value@advantage.model

advantage:
  # value_checkpoint: /mnt/public/guqiuyi/RLinf_active/logs/value_sft/x2robot_sft_value_fold_towel-20260520-20:54:17/value_sft/checkpoints/global_step_3000/actor/model_state_dict
  # value_checkpoint: /mnt/public/guqiuyi/RLinf_active/logs/value_sft/x2robot_sft_value_checkout_chips-20260606-17:34:22/value_sft/checkpoints/global_step_3000/actor/model_state_dict
  # value_checkpoint: /mnt/public/guqiuyi/RLinf_active/logs/value_sft/x2robot_sft_value-20260614-17:36:51/value_sft/checkpoints/global_step_3000/actor/model_state_dict
  # clean_table 的 value checkpoint —— 训练完后用 CLI 覆盖此项
  value_checkpoint: /mnt/public/guqiuyi/RLinf_active/logs/value_sft/x2robot_sft_value_robometer_ct-20260807-07:56:27/robometer_value_sft_clean_table_ct/checkpoints/global_step_3000/actor/model_state_dict
  device: "cuda"
  batch_size: 1024
  flush_interval: 256
  num_dataloader_workers_per_gpu: 12
  prefetch_factor: 2
  discount_next_value: true

  # Top X% of samples will have positive advantage (threshold at 1-X percentile)
  positive_quantile: 0.3

  # Tag for saving/reading: advantages_{tag}.parquet / returns_{returns_tag}.parquet
  # 写出 meta/advantages_{tag}.parquet；读取 meta/returns_{returns_tag}.parquet
  # returns_tag 必须与 value model 训练时的 data.tag 一致 (rbm_n64_mapB)，
  # 否则 value 学的目标与这里算 advantage 用的 return 不是同一套。
  tag: "rbm_n64_mapB"
  returns_tag: "rbm_n64_mapB"

  # Optional frame-level success/fail classifier correction.
  # When classifier_checkpoint is set, Phase 1.5 runs the classifier in
  # parallel with V(o_t) and the final advantage uses
  # V_final = V_orig - classifier_lambda * logit.
  # Default (null checkpoint) → pipeline behaves exactly as before.
  classifier_checkpoint: null
  classifier_lambda: 0.5
  classifier_batch_size: null   # defaults to advantage.batch_size when null
  classifier_model:             # optional per-run overrides for classifier config
    vision_repo_id: null        # e.g. "facebook/dinov2-small"
    use_proprio: null
    proprio_dim: null
    image_size: null
    label_smoothing: null
    precision: null
    max_state_dim: null

  model:
    critic_expert_variant: "gemma_1m"
    tokenizer_path: /mnt/public/guqiuyi/RLinf_active/pretrained_models/gemma-3-270m
    siglip_path: /mnt/public/guqiuyi/RLinf_active/pretrained_models/siglip2-so400m-patch14-224
    gemma3_path: /mnt/public/guqiuyi/RLinf_active/pretrained_models/gemma-3-270m

data:
  model_type: "pi0"
  # Options: "libero", "franka"
  robot_type: "x2robot"

  train_data_paths:
    # - dataset_path: /mnt/public/guqiuyi/huggingface/lerobot/fold_towel_gqy_recap_sft
    # - dataset_path: /mnt/public/guqiuyi/huggingface/lerobot/checkout_chips_gqy_recap_sft
    # - dataset_path: /mnt/public/guqiuyi/huggingface/lerobot/restock_cola_gqy_recap_sft
    - dataset_path: /mnt/resource/steam_dataset/clean_table/lerobot/clean_table_ygg06170618_steam_sft
      robot_type: "x2robot"
      type: "sft"
      weight: 1.0
    # - dataset_path: /mnt/public/guqiuyi/huggingface/lerobot/fold_towel_gqy_recap_rollout
    # - dataset_path: /mnt/public/guqiuyi/huggingface/lerobot/checkout_chips_gqy_recap_rollout
    # - dataset_path: /mnt/public/guqiuyi/huggingface/lerobot/restock_cola_gqy_recap_rollout
    - dataset_path: /mnt/resource/steam_dataset/clean_table/lerobot/clean_table_gqy062306250626_steam_rollout
      robot_type: "x2robot"
      type: "rollout"
      weight: 1.0

  # train_data_paths:
  #   - dataset_path: "/path/to/sft_dataset"
  #     robot_type: "libero"
  #     type: "sft"
  #     weight: 1.0

    # Uncomment to add rollout datasets:
    # - dataset_path: "/path/to/rollout_dataset"
    #   robot_type: "libero"
    #   type: "rollout"
    #   weight: 1.0

  # N in: A = normalize(r_{t:t+N}) + gamma^N * V(o_{t+N}) - V(o_t)
  advantage_lookahead_step: 10
  gamma: 1.0

distributed:
  enabled: true
  backend: "nccl"
  timeout: 3600

hydra:
  run:
    dir: .
  output_subdir: null
  job:
    chdir: false
